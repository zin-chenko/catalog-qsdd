{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "catalog-qsdd": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "dist/catalog-qsdd",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              }
            ],
            "styles": ["src/styles.css"],
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "extraWebpackConfig": "webpack.config.js",
            "singleBundle": true,
            "keepStyles": true,
            "bundleStyles": true
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "buildOptimizer": false,
              "vendorChunk": true,
              "namedChunks": true
            },
            "qpalette": {
              "main": "src/qpalette/main.ts",
              "tsConfig": "tsconfig.qpalette.json",
              "outputPath": "dist/catalog-qsdd-qpalette",
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "catalog-qsdd:build:production"
            },
            "development": {
              "buildTarget": "catalog-qsdd:build:development"
            },
            "qpalette": {
              "buildTarget": "catalog-qsdd:build:development,qpalette"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "extraWebpackConfig": "webpack.config.js",
            "singleBundle": true,
            "keepStyles": true,
            "bundleStyles": true
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
