{
  "name": "catalog-qsdd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve catalog-qsdd --port=4200 --live-reload=false",
    "build": "ng build catalog-qsdd --configuration production --optimization true",
    "watch": "ng build --watch --configuration development",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:repository": "playwright test --config playwright.repository.config.ts",
    "ng": "ng",
    "prod": "pnpm run build",
    "setup:qpalette": "node scripts/install-qpalette.mjs",
    "build:qpalette": "node scripts/check-qpalette.mjs && ng build catalog-qsdd --configuration production,qpalette --optimization true",
    "start:qpalette": "node scripts/check-qpalette.mjs && ng serve catalog-qsdd --configuration qpalette --port=4201 --live-reload=false"
  },
  "dependencies": {
    "@angular-architects/module-federation": "21.2.2",
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/elements": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/router": "21.2.19",
    "@diasoft/qpalette-auth": "8.1.3",
    "@diasoft/qpalette-core": "8.1.3",
    "@diasoft/qpalette-urls": "8.1.3",
    "@diasoft/qpalette-visual": "8.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@jsverse/transloco": "8.3.0",
    "fflate": "^0.8.3",
    "primeng": "21.1.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.21",
    "@angular/cli": "21.2.21",
    "@angular/compiler-cli": "21.2.19",
    "@playwright/test": "^1.56.1",
    "ngx-build-plus": "20.0.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "webpack": "5.105.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
